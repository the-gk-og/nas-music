# Copy to .env (next to compose.yaml) and fill in. Lines starting with # are ignored.
# .env holds your settings (and maybe a tunnel token): don't commit it or share it.

# ---- Required ---------------------------------------------------------------------------------------
# Your music folder on the NAS. Mounted read-only; the server never changes it.
#   Synology: /volume1/music   Unraid: /mnt/user/music   TrueNAS: /mnt/<pool>/<dataset>   QNAP: /share/Music
MUSIC_DIR=/volume1/music

# The NAS's LAN IP address. Give the NAS a fixed IP (a DHCP reservation in your router) first: the apps
# remember this address, and it is written into the server's HTTPS certificate.
LAN_HOST=192.168.1.50

# ---- Recommended ------------------------------------------------------------------------------------
# Where the server keeps its database, certificate and caches. Default: a Docker volume. A folder is
# easier to back up; create it first and give it to PUID:PGID (README "Permissions").
# DATA_DIR=/volume1/docker/homebeat

# Shown in the apps after pairing.
SERVER_NAME=Home NAS

# Nightly mixes run at 02:00 in this time zone (a tz database name).
TIMEZONE=Europe/London

# The first admin account. Leave ADMIN_PASSWORD empty to have one generated and printed in the log
# (`docker compose logs server`). Either way, change it after signing in. 8+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Permissions ------------------------------------------------------------------------------------
# The user and group the server runs as. It needs to READ MUSIC_DIR and WRITE DATA_DIR.
# Find yours with `id <username>` on the NAS. TrueNAS "apps" = 568, Synology first user ~1026/100,
# Unraid "nobody" = 99/100.
PUID=568
PGID=568
# An extra group that can read the music, if PUID can't by itself (otherwise leave it as PGID).
# MUSIC_GID=568

# ---- Ports (change the left-hand numbers only if something else already uses them) -----------------
LAN_PORT=8443       # HTTPS for the apps and web player
CAST_PORT=8090      # speakers (Chromecast, DLNA, Snapcast) fetch audio here; LAN only
HTTP_PORT=8080      # plain HTTP, bound to 127.0.0.1 only, for a reverse proxy on this machine

# ---- Remote access (optional, README "Remote access") ----------------------------------------------
# Your public address, if you set one up, e.g. https://music.example.com
# PUBLIC_URL=
# Cloudflare Tunnel: uncomment both lines and paste the tunnel token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# ---- Optional ---------------------------------------------------------------------------------------
# OPUS_CACHE_GB=10                # disk space for transcoded audio
# UPLOADS_DIR=/volume1/music-uploads   # then also UPLOAD_ROOT=/uploads and the uploads line in compose.yaml
# UPLOAD_ROOT=
# AUDIOBOOKS_DIR=/volume1/audiobooks   # then also AUDIOBOOKS_ROOT=/audiobooks and the line in compose.yaml
# AUDIOBOOKS_ROOT=
# BACKUP_DIR=/volume2/backups/music     # off-site backups (another disk/dataset): then the line in compose.yaml
#                                       # and backup_copy_to = "/backup" in config.toml (README "Backups")
# Host networking so Chromecast/DLNA speakers are found automatically (README "Speakers"):
# COMPOSE_FILE=compose.yaml:compose.host-network.yaml

# ---- Image ------------------------------------------------------------------------------------------
# Where the server image comes from, and the name Docker gives this stack (containers, volume).
IMAGE=ghcr.io/the-gk-og/homebeat:latest
STACK_NAME=homebeat
# WITH_ANALYSIS=1                 # only for `docker compose build`: 0 = skip Essentia (smaller, simpler mixes)
