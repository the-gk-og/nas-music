{
  "id": "/",
  "name": "Homebeat",
  "short_name": "Homebeat",
  "description": "Your self-hosted music library.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "/#/search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "url": "/#/library", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Now playing", "url": "/#/now", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
